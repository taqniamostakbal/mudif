<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav item tint: purple when selected, the theme's muted
     on-surface tone otherwise (adapts to dark mode). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/mudif_purple" android:state_checked="true" />
    <item android:color="@color/mudif_purple" android:state_selected="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
