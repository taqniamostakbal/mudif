<?xml version="1.0" encoding="utf-8"?>
<!-- Night values for the dark mode semantic colors defined in
     values/colors.xml, plus the bottom nav unselected tint.
     The app theme is Theme.Material3.DayNight, so the Material
     attributes (colorSurface, colorOnSurface, colorBackground)
     already switch at night; these overrides switch the app's own
     hardcoded light surfaces (screen, bubbles, cards, tiles, chips,
     muted text) to dark equivalents. The brand purple header and
     the vivid category gradients stay the same in both modes.
     The light lavender pill (mudif_pill) and the light circle fill
     are deliberately kept light at night: the purple nav icon and
     the purple glyphs on them stay readable only on a light
     ground, the same as Material secondaryContainer. -->
<resources>
    <color name="mudif_unselected">#9E9E9E</color>
    <color name="screen_bg">#121214</color>
    <color name="bubble_agent_bg">#26262E</color>
    <color name="bubble_agent_stroke">#3A3A46</color>
    <color name="bubble_user_bg">#3D2E8C</color>
    <color name="card_bg">#232329</color>
    <color name="card_stroke">#383844</color>
    <color name="icon_tile_bg">#26262E</color>
    <color name="icon_tile_stroke">#383844</color>
    <color name="circle_light_fill">#B9AEF5</color>
    <color name="chip_bg_unselected">#2C2C36</color>
    <color name="chip_text_unselected">#E0E0E0</color>
    <color name="text_muted">#A8A8B3</color>
    <color name="text_muted_dark">#B5B5BD</color>
</resources>
