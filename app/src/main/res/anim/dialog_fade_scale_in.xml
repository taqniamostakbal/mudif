<?xml version="1.0" encoding="utf-8"?>
<!-- p56: dialog open animation (fade + scale up from 0.95, 180ms,
     the motion_duration_transition value). Applied to every Mudif
     dialog window via the Mudif.Dialog.Animation style. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_decelerate">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="180" />
    <scale
        android:fromXScale="0.95"
        android:toXScale="1"
        android:fromYScale="0.95"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="180" />
</set>
