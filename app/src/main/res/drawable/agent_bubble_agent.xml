<?xml version="1.0" encoding="utf-8"?>
<!-- p30 KissaKoti redesign: uniformly rounded 18dp (no tail), solid
     WHITE fill with a lavender hairline. The timestamp now sits
     INSIDE the bubble (see item_agent_message.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bubble_agent_bg" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/bubble_agent_stroke" />
</shape>
