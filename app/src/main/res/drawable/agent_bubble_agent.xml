<?xml version="1.0" encoding="utf-8"?>
<!-- p30 KissaKoti redesign: uniformly rounded 18dp (no tail).
     p98: the fill and the hairline are theme attrs now
     (?attr/mudifBubbleAgentBg, ?attr/mudifCardStroke), so the
     agent bubble follows the theme (#3A345C dark, #EFECF8
     light, #65568C gradient). The timestamp sits INSIDE the
     bubble (see item_agent_message.xml); the adapter sets the
     text and timestamp colors per role. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/mudifBubbleAgentBg" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/mudifCardStroke" />
</shape>
