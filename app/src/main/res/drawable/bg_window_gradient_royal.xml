<?xml version="1.0" encoding="utf-8"?>
<!-- p98: window background gradient, Royal Gradient theme.
     Top #593BFE to bottom #2A1660 (the brand purple, deepened).
     Referenced as ?attr/mudifWindowBg by the agent and
     brain-providers screens, and as android:windowBackground
     by Theme.Mudif.RoyalGradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#593BFE"
        android:endColor="#2A1660"
        android:angle="270"
        android:type="linear" />
</shape>
