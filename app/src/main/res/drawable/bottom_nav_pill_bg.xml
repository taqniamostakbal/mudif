<?xml version="1.0" encoding="utf-8"?>
<!-- p52: the pill is a real card now: solid card_bg (white in light,
     #232329 at night) instead of ?attr/colorSurface, which is the
     same #FEF7FF as the screen background, so the old pill blended
     into the background and only its shadow defined it.
     p53: the p45 rig round proved that was not enough: #FFFFFF on
     #FEF7FF differs by 8 in one channel only, so on the real screen
     the pill still reads as a flat strip, no edge, no corners. The
     12dp elevation shadow is invisible on near-white. So the pill
     gets the same 1dp lavender hairline every other white card in
     the app already has (card_white_rounded.xml): card_stroke,
     #DCD6FF light / #383844 night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_bg" />
    <corners android:radius="40dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_stroke" />
</shape>
