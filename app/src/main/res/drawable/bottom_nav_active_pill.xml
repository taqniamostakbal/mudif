<?xml version="1.0" encoding="utf-8"?>
<!-- p52: the selected tab's pill in the bottom nav (64x44dp, pale
     #E4DEFF, 16dp corners). Taller than the old Material 64x32dp
     indicator so the bigger 22dp icons fit inside it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mudif_pill" />
    <corners android:radius="16dp" />
</shape>
