<?xml version="1.0" encoding="utf-8"?>
<!-- p56: the shared card gradient for Compact row cards (14dp corners,
     Widget.Mudif.Card.Compact). Same values as home_stat_gradient
     (#593BFE to deeper violet #3D2BB5, diagonal 135 degrees): one
     gradient for every card in the app, only the corner radius
     changes with the card style. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#593BFE"
        android:endColor="#3D2BB5"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
