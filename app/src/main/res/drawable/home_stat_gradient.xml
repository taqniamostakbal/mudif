<?xml version="1.0" encoding="utf-8"?>
<!-- p50: stat card background, professional purple gradient in the
     Mudif family (#593BFE to a deeper violet #3D2BB5, diagonal like
     the hero cat_all, 16dp corners to match Widget.Mudif.Card).
     White text on this gradient is 6.0:1 to 9.5:1 and #E6E6FF is
     4.9:1 to 7.8:1, both passing WCAG AA. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#593BFE"
        android:endColor="#3D2BB5"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
