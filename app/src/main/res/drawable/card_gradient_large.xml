<?xml version="1.0" encoding="utf-8"?>
<!-- p56: the shared card gradient for Large cards (20dp corners,
     Widget.Mudif.Card.Large) and for the old card_white_rounded
     surfaces (agent profile card, brain provider/search cards).
     Same values as home_stat_gradient (#593BFE to deeper violet
     #3D2BB5, diagonal 135 degrees): one gradient for every card
     in the app, only the corner radius changes with the card style. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#593BFE"
        android:endColor="#3D2BB5"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
