<?xml version="1.0" encoding="utf-8"?>
<!-- P16: branded dialog background, rounded card for all Mudif dialogs.
     p56: the window background is the standard purple gradient
     (#593BFE to deeper violet #3D2BB5, diagonal 135), so every dialog
     is a gradient card. Dialog text is white / #E6E6FF and dialog
     buttons are OnPurple / SecondaryOnPurple / TextOnPurple, never
     purple-on-purple. 20dp corners, same as before. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#593BFE"
        android:endColor="#3D2BB5"
        android:angle="135"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
