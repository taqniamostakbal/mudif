<?xml version="1.0" encoding="utf-8"?>
<!-- p30 KissaKoti redesign: uniformly rounded 18dp, no tail.
     p98: the fill is a theme attr now (?attr/mudifBubbleUserBg:
     #593BFE dark/light, #FFFFFF gradient). The adapter sets the
     text and timestamp colors per role (white text on purple,
     purple text on white in the gradient theme), so the user
     bubble inverts with the theme instead of vanishing on it.
     p107: 20dp radii, modern roomy bubble. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/mudifBubbleUserBg" />
    <corners android:radius="20dp" />
</shape>
