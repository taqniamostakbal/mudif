<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mudif" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mudif_purple</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/mudif_teal</item>
        <item name="android:statusBarColor">@color/mudif_purple</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <!-- Mudif design system (values/styles.xml): every card and every
             unstyled button gets the Mudif look by default; an explicit
             style on a view still wins over these defaults. -->
        <item name="materialCardViewStyle">@style/Widget.Mudif.Card</item>
        <item name="buttonStyle">@style/Widget.Mudif.Button.Primary</item>
        <item name="bottomNavigationStyle">@style/Widget.Mudif.BottomNavigation</item>
    </style>
</resources>
