<?xml version="1.0" encoding="utf-8"?>
<!-- P16: branded progress dialog content (title + status + bar).
     p56: the dialog is a gradient card (dialog_mudif_bg). Title
     white, status #E6E6FF, the bar is white (a purple bar would
     vanish on the gradient). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:fontFamily="@font/cairo" />

    <TextView style="@style/TextAppearance.Mudif.Caption"
        android:id="@+id/dialog_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="@color/card_text_secondary"
        android:fontFamily="@font/cairo" />

    <ProgressBar
        android:id="@+id/dialog_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="@android:color/white"
        android:indeterminateTint="@android:color/white" />
</LinearLayout>
