<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#593BFE"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_mudif"
        android:contentDescription="@string/about_system_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/about_system_name"
        android:textSize="28sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/lifta" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/about_tagline"
        android:textSize="16sp"
        android:textColor="#DCD6FF"
        android:fontFamily="@font/cairo" />

</LinearLayout>
