<?xml version="1.0" encoding="utf-8"?>
<!-- Branded language picker (Mudif style). Replaces the plain
     AlertDialog.Builder + setItems() picker: that one used the system
     list style (not the app's look) AND its item list never appeared
     when setMessage was also set (rig: 15 nodes, title + message only,
     no ListView). Here the 3 languages are real buttons in the dialog
     layout, so they always show. Same pattern as dialog_mudif_info:
     24dp padding, Cairo, purple buttons, dialog_mudif_bg window. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="@font/cairo" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="@font/cairo" />

    <!-- The 3 languages, each its own name (readable before any locale
         is applied). Full-width outlined purple buttons; the currently
         selected one is filled purple (set in code). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_option_fusha"
            style="@style/Widget.Mudif.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_option_darija"
            style="@style/Widget.Mudif.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_option_english"
            style="@style/Widget.Mudif.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
