<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/mudif_purple"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_games"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/lifta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/games_subtitle"
            android:textSize="14sp"
            android:textColor="#DCD6FF"
            android:fontFamily="@font/cairo" />
    </LinearLayout>

    <!-- P16: games are NOT now (user's order) — a clean coming-soon
         screen, no fake installable list. The real gaming container
         (Box64+Wine) comes later. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coming_soon"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/mudif_purple"
            android:fontFamily="@font/cairo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/coming_soon_long"
            android:textSize="15sp"
            android:textColor="#555555"
            android:fontFamily="@font/cairo"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
