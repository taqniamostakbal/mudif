<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 4: مساعد مضيف chat tab. Two modes in one fragment, same header
     pattern as the other tabs (purple header + menu button):
     - Chat: native message list, quick-action chips, input + voice.
     - Console: WebView on the agent server (localhost only) with an
       honest error state when the server is not running.
     p29 ROOT FIX: p28 used a ConstraintLayout root and p27 a LinearLayout
     with nested weights. BOTH failed identically on the rig: only the
     header rendered (stretched to fill the screen) and every other view
     measured 0 or invisible. Root cause = nested weights / constraints
     never resolving, so children got 0 size. This version ELIMINATES
     both: a plain vertical LinearLayout root, header FIXED height, and
     ONE single weight (agent_recycler, direct child of the root), the
     same structure StoreFragment uses and the rig proves works. No
     nested weights, no ConstraintLayout, no 0dp children inside a 0dp
     parent. All view IDs preserved.
     p31 ROOMIER REDESIGN (Anas: the chat was "خايبة و ضيقة بزاف",
     keyboard hard, bubble wrong): header 88dp -> 64dp ONE compact row
     (menu + penguin avatar + name/status + brain pill with a chevron);
     the reply-language button moves out of the header into the scroll
     row; mode toggle + language + chips + clear merge into ONE
     horizontal scroll row (was two rows); the profile card hides once
     the chat has more than the greeting (it no longer eats 155px
     forever) and taps through to the provider screen; the input bar is
     KissaKoti-like (paperclip + WIDE field with the mic inside its edge
     + round purple send). The message list now takes ~64% of the
     screen once the card is hidden. The scroll row stays visible in
     console mode (only the chat items inside it hide) so the mode
     toggle can always switch back. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6FF">

    <!-- Header: ONE compact row, 64dp. Clay-penguin avatar + agent name
         (18sp, single line, ellipsized) + status + brain pill. The
         brain pill shows the current brain's short name + a chevron
         (set in code) so it reads as a tappable dropdown; tapping it
         opens the provider-selection screen. Tapping the avatar or the
         name shows the agent About text. -->
    <LinearLayout
        android:id="@+id/agent_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mudif_purple"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/ui_nav_menu_desc"
            android:onClick="openDrawer" />

        <ImageView
            android:id="@+id/agent_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/avatar_mudif"
            android:contentDescription="@string/agent_name" />

        <!-- p30 KissaKoti header: name in Lifta + green verified badge,
             and a status row (green dot + "متصل") under it. The
             subtitle string now holds the status text. -->
        <LinearLayout
            android:id="@+id/agent_identity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView style="@style/Widget.Mudif.HeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_name"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/lifta" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/dot_online"
                    android:src="@drawable/ic_check"
                    android:padding="3dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_online" />

                <TextView style="@style/Widget.Mudif.HeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/agent_subtitle"
                    android:textSize="12sp"
                    android:textColor="#DCD6FF"
                    android:fontFamily="@font/cairo" />
            </LinearLayout>
        </LinearLayout>

        <!-- p32: Clear chat lives HERE now, always visible in the
             header. It was the last item of the horizontal scroll row,
             off-screen to the left, so the p31 verification could not
             find it (and the session reset was unreachable). Same id,
             so the fragment's clearHistory() wiring is unchanged. -->
        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.OnPurple"
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/agent_clear_history_short"
            android:contentDescription="@string/agent_clear_history"
            android:fontFamily="@font/cairo"
            android:textSize="13sp"
            app:cornerRadius="20dp" />

        <!-- Brain picker (p22, p31 screen): the model the agent answers
             with. Local (Ollama Qwen3 1.7B) by default; the cloud models
             come from opencode-providers.json. The button shows the
             current brain's short name + a chevron; tapping it opens
             the provider-selection screen (all 10 free platforms). -->
        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.OnPurple"
            android:id="@+id/btn_brain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="120dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:contentDescription="@string/brain_providers_tap_to_change"
            android:fontFamily="@font/cairo"
            android:textSize="13sp"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- ================= Chat mode (direct children of the root) ================= -->
    <!-- p31: ONE horizontal scroll row for mode toggle + reply language
         + quick-action chips + clear history. Was two rows (mode_row +
         chips_scroll, ~100px); now one (~44px). The row itself stays
         visible in console mode (AgentFragment hides only the chat
         items inside it) so the Chat/Console toggle can always switch
         back. Direct child of the root, so it is always laid out. -->
    <HorizontalScrollView
        android:id="@+id/chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:checkedButton="@id/mode_chat"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                    android:id="@+id/mode_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_mode_chat"
                    android:fontFamily="@font/cairo"
                    android:textSize="13sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                    android:id="@+id/mode_console"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_mode_console"
                    android:fontFamily="@font/cairo"
                    android:textSize="13sp"
                    app:cornerRadius="16dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Reply language for the agent (Fusha default / Darija /
                 English). Stored, and carried with every message.
                 p31: moved out of the header (it made the header two
                 rows tall) into this scroll row, Secondary style on
                 the cream background. -->
            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/btn_reply_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:contentDescription="@string/agent_reply_language"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_desktop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_quick_desktop"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_quick_apps"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_quick_help"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_quick_search"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_open_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_quick_open_app"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_quick_settings"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <!-- Vision increment 1: "شوف الشاشة" looks at the
             desktop and describes it. Disabled with the reason when
             the desktop is down or the vision model is missing
             (AgentFragment.refreshVisionChip). -->
            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
                android:id="@+id/chip_vision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/agent_vision_chip"
                android:contentDescription="@string/agent_vision_chip"
                android:fontFamily="@font/cairo"
                android:textSize="13sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- p30 KissaKoti redesign: "TODAY" divider + white profile card,
         like the reference (TODAY above the pet card, card above the
         messages). Both are chat-mode views: hidden in console mode
         (see AgentFragment showChat/showConsole). The card shows the
         agent name in Lifta + the current brain model and status; the
         model line is set in code (updateBrainButton). p31: the card
         hides once the chat has more than the greeting (it no longer
         eats 155px forever) and tapping it opens the provider screen
         (the "تغيير" hint says so). -->
    <TextView
        android:id="@+id/agent_today_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="@string/agent_today"
        android:textSize="11sp"
        android:textColor="#8A8A8A"
        android:fontFamily="@font/cairo" />

    <LinearLayout
        android:id="@+id/agent_profile_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_white_rounded"
        android:elevation="2dp"
        android:padding="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/avatar_mudif"
            android:contentDescription="@string/agent_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_name"
                android:textSize="18sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/lifta" />

            <TextView
                android:id="@+id/agent_profile_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/agent_brain_local"
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:fontFamily="@font/cairo" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تغيير"
            android:textSize="13sp"
            android:textColor="@color/mudif_purple"
            android:fontFamily="@font/cairo" />
    </LinearLayout>

    <!-- Message list. THE single weight in this layout, direct child of
         the root (same proven pattern as StoreFragment's programs list).
         It fills whatever space is left after header + scroll row +
         input, and recycles its rows.
         p32: minHeight 100dp backstop, with the keyboard open the
         fixed stack (header + row + input + typing/action) used to
         squeeze this weight to 6px; the keyboard listener hides the
         chrome, and this floor keeps the list from ever collapsing. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/agent_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:background="#F7F6FF"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Brain download card (p22): shown when Ollama answers but
         the model is missing. One-tap pull with a real progress
         bar, no terminal. Hidden once the model is present. -->
    <LinearLayout
        android:id="@+id/brain_download_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/search_box_bg"
        android:padding="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/brain_download_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brain_download_title"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/cairo" />

        <ProgressBar
            android:id="@+id/brain_download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
            android:id="@+id/btn_brain_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/brain_download_button"
            android:fontFamily="@font/cairo"
            android:textSize="14sp"
            app:cornerRadius="22dp" />
    </LinearLayout>

    <!-- Loading state: shown while a turn runs. Text is set in
         code (starting server / thinking / running tool). -->
    <TextView
        android:id="@+id/agent_typing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        android:text="@string/agent_thinking"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="@font/cairo"
        android:visibility="gone" />

    <!-- Brain fix phase 2: the local-slow chip. Hidden until a
         local turn runs 60 s without a first token; tapping it stops
         the turn and opens the provider screen. -->
    <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
        android:id="@+id/chip_slow_brain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:fontFamily="@font/cairo"
        android:textSize="13sp"
        android:text="@string/agent_slow_brain"
        android:contentDescription="@string/agent_slow_brain"
        android:visibility="gone"
        app:cornerRadius="16dp" />

    <!-- Action after a send: Stop while a turn runs, Retry when
         a turn failed, or "open desktop" when the engine is not
         installed. Label and action are set in code; hidden
         until a turn runs or fails.
         p33: minHeight 0dp, a MaterialButton defaults to 48dp
         (96px at this density) and that height came straight out
         of the message list while the keyboard was open. -->
    <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Secondary"
        android:id="@+id/btn_agent_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:fontFamily="@font/cairo"
        android:textSize="13sp"
        android:visibility="gone"
        app:cornerRadius="16dp" />

    <!-- Input row: paperclip, wide field (mic inside its edge), send.
         p31 KissaKoti style: ONE round attachment button (paperclip,
         opens the voice menu) + a WIDE white rounded field (the
         FrameLayout is the single weight here; the EditText inside is
         match_parent so there is no nested weight) with the mic button
         overlaid at its end edge + the round purple send button. The
         voice-output toggle moved into the paperclip menu (it was a
         third round button crowding the field). -->
    <LinearLayout
        android:id="@+id/input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_light_bg"
            android:src="@drawable/ic_attach"
            android:contentDescription="@string/agent_attach_desc"
            android:padding="10dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/search_box_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <EditText
                android:id="@+id/input_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/agent_hint"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="#8A8A8A"
                android:fontFamily="@font/cairo"
                android:textSize="15sp"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:maxLines="4" />

            <ImageButton
                android:id="@+id/btn_voice_in"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mic"
                android:tint="@color/mudif_purple"
                android:contentDescription="@string/agent_voice_in_desc"
                android:padding="4dp" />
        </FrameLayout>

        <!-- p30 KissaKoti redesign: round purple send button with a
             paper-plane icon. Same ID, so the fragment code (click
             listener + isEnabled) is unchanged. -->
        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_send"
            android:padding="12dp"
            android:contentDescription="@string/agent_send" />
    </LinearLayout>

    <!-- ================= Console mode (WebView) ================= -->
    <!-- Hidden by default (chat is the default mode). When console mode
         is chosen, AgentFragment hides the chat views (chips, recycler,
         input row) and shows this container instead. It is a direct child
         of the root with weight=1 so it fills the same space the chat
         list used. -->
    <FrameLayout
        android:id="@+id/console_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <WebView
            android:id="@+id/agent_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error state: the agent server is not running. The logo
             keeps the screen on-brand; Retry reloads the console. -->
        <LinearLayout
            android:id="@+id/agent_server_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/colorSurface"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/logo_mudif"
                android:contentDescription="@string/agent_name" />

            <TextView style="@style/TextAppearance.Mudif.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/agent_server_not_running"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:fontFamily="@font/cairo" />

            <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                android:id="@+id/btn_console_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/agent_server_retry"
                android:fontFamily="@font/cairo"
                android:textSize="14sp"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
