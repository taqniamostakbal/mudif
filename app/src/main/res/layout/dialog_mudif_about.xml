<?xml version="1.0" encoding="utf-8"?>
<!-- p56: About dialog, the owner card. The dialog window is the
     purple gradient (dialog_mudif_bg); every text is white /
     #E6E6FF. Order: owner avatar on top (circular, white ring),
     app name, owner name, version chip, one-line description,
     channel credit, GitHub link, copyright at the bottom, then
     the YouTube button and the close button. The GitHub link is
     a tappable text line (it replaces the old GitHub button).
     Closes with the button and with back (cancelable). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/about_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/owner_avatar"
            android:scaleType="centerCrop"
            android:contentDescription="@string/about_avatar_desc"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Mudif.Circle"
            app:strokeColor="@android:color/white"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/about_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:fontFamily="@font/lifta" />

        <TextView
            android:id="@+id/about_owner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/about_owner_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/about_oneliner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/about_oneliner"
            android:textSize="13sp"
            android:textColor="@color/card_text_secondary"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/about_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/about_channel"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/about_github_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/about_github_url"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/about_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/about_copyright"
            android:textSize="12sp"
            android:textColor="@color/card_text_secondary"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_btn_youtube"
            style="@style/Widget.Mudif.Button.SecondaryOnPurple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="YouTube"
            android:fontFamily="@font/cairo"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.OnPurple"
            android:id="@+id/about_btn_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ok"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>
