<?xml version="1.0" encoding="utf-8"?>
<!-- One option row for the branded select dialog (MudifDialog.select).
     Inflated once per choice. Same look as the language picker options:
     p56: outlined WHITE button, Cairo, 12dp corners (the dialog is a
     gradient card now, so the old outlined purple was invisible);
     the current choice is filled white in code. -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Mudif.Button.SecondaryOnPurple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/cairo"
    app:cornerRadius="12dp" />
