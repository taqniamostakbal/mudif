<?xml version="1.0" encoding="utf-8"?>
<!-- p28 ROOT FIX (Store "All" crash): the programs list MUST NOT be
     wrap_content inside a NestedScrollView. Before, programs_recycler
     was wrap_content + nestedScrollingEnabled=false inside the outer
     NestedScrollView, so tapping "All" (1,139 programs) forced the
     RecyclerView to create + measure ALL 1,139 item views at once to
     compute its height -> OutOfMemory / the app died.
     p30: the screen is ONE scrolling list (ConcatAdapter in the single
     weight=1 programs_recycler, see the comment above the search box),
     so the list only binds the visible items (real RecyclerView
     recycling) and can never measure 0. The search stays fixed above
     the list while browsing programs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mudif_purple"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/ui_nav_menu_desc"
            android:onClick="openDrawer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView style="@style/Widget.Mudif.HeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_store"
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/lifta" />

            <TextView style="@style/Widget.Mudif.HeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/store_subtitle"
                android:textSize="14sp"
                android:textColor="#DCD6FF"
                android:fontFamily="@font/cairo" />
        </LinearLayout>
    </LinearLayout>

    <!-- p30 ROOT FIX (Store "All" list invisible, p28 + p29): the
         measured heights on the rig prove the fixed top section
         (header 291px + distro 344px + search 112px + category 201px)
         consumed the ENTIRE 976px fragment area, so the weight=1
         programs_recycler got 0px. No fixed top section can fit: the
         content is 97% of the screen. So there is NO separate top
         section any more. The screen is ONE scrolling list
         (ConcatAdapter: distro card + category grid + program cards,
         GridLayoutManager span 2, categories span 1, everything else
         spans 2) inside the single weight=1 programs_recycler. The
         distro card and the category grid scroll away naturally while
         browsing, all 8 categories stay reachable, and the list can
         never measure 0 because it is the only weighted child. -->
    <!-- P16.1: plain EditText, not TextInputEditText. The Material
         TextInputLayout wrapper broke the search field's input
         connection (focus worked, no keystroke arrived, mInputEditorInfo
         empty), so the box is a plain EditText on a rounded background. -->
    <EditText style="@style/Widget.Mudif.SearchBox"
        android:id="@+id/search_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/search_box_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:padding="12dp"
        android:hint="@string/store_search_hint"
        android:fontFamily="@font/cairo"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1" />

    <!-- The programs list scrolls on its own (weight=1 fills the rest
         of the screen). It recycles views, so "All" (1,139 programs)
         only binds the ~10 visible cards instead of all of them. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/programs_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <TextView style="@style/TextAppearance.Mudif.Caption"
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/store_no_results"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="@font/cairo"
        android:visibility="gone" />
</LinearLayout>
