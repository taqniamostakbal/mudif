<?xml version="1.0" encoding="utf-8"?>
<!-- P17.2: one scrolling page. Before, only the programs list scrolled
     (weight=1) while the header + Debian card + search + chips were fixed
     and swallowed every drag that started on them, so most of the screen
     could not scroll the list and programs stayed hidden below. Now the
     whole page scrolls as one: the programs list does not scroll itself
     (nestedScrollingEnabled=false, wrap_content) and the outer
     NestedScrollView carries the scroll. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/mudif_purple"
            android:padding="24dp">

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_menu"
                android:contentDescription="القائمة"
                android:onClick="openDrawer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_store"
                    android:textSize="28sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/lifta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/store_subtitle"
                    android:textSize="14sp"
                    android:textColor="#DCD6FF"
                    android:fontFamily="@font/cairo" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:padding="12dp" />

        <!-- P16.1: plain EditText, not TextInputEditText. The Material
             TextInputLayout wrapper broke the search field's input
             connection (focus worked, no keystroke arrived, mInputEditorInfo
             empty), so the box is a plain EditText on a rounded background. -->
        <EditText
            android:id="@+id/search_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/search_box_bg"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:hint="@string/store_search_hint"
            android:fontFamily="@font/cairo"
            android:inputType="text"
            android:maxLines="1" />

        <!-- P19 Phase 1: category gradient cards (2-column grid) replace
             the plain filter chips. Same tap-to-filter behaviour. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/category_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/programs_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:padding="12dp" />

        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/store_no_results"
            android:textSize="16sp"
            android:textColor="#666666"
            android:fontFamily="@font/cairo"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
