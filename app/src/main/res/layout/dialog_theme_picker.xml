<?xml version="1.0" encoding="utf-8"?>
<!-- Branded theme picker (Mudif style). Same pattern as
     dialog_language_picker: the 3 themes are real buttons in the
     dialog layout, so they always show. 24dp padding, Cairo,
     purple buttons, dialog_mudif_bg window. The title is the
     theme title, the message is the theme description; the
     current theme is filled white in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:fontFamily="@font/cairo" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="@color/card_text_secondary"
        android:fontFamily="@font/cairo" />

    <!-- The 3 themes, each its own Fusha name. Full-width
         outlined purple buttons; the currently selected one is
         filled white (set in code). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_option_dark"
            style="@style/Widget.Mudif.Button.SecondaryOnPurple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_option_light"
            style="@style/Widget.Mudif.Button.SecondaryOnPurple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_option_gradient"
            style="@style/Widget.Mudif.Button.SecondaryOnPurple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
