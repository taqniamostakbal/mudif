<?xml version="1.0" encoding="utf-8"?>
<!-- P19 Phase 2: the main screen is now a DrawerLayout, the content
     (fragment host + bottom nav) plus the side menu (SidebarView,
     gravity start = right side in RTL). p46: the drawer content is a
     custom SidebarView (expanded panel / collapsed rail morph) instead
     of a NavigationView. p49: the active pill and circle stay inside
     the panel and rail, so nothing here needs clipChildren false. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- p48: custom bottom nav (ui.nav.BottomNavView) with Lottie
             animated icons. p55: the card is the purple gradient
             (the same gradient as the home stat cards), 16dp
             corners, white icons and labels; same id, same 16dp
             margins and 12dp bottom as before, so MainActivity
             wiring stays put. -->
        <com.bolm.mudif.ui.nav.BottomNavView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bottom_nav_pill_bg"
            android:elevation="12dp" />
    </LinearLayout>

    <!-- p46: custom sidebar (expanded panel / collapsed rail), same id
         as the old NavigationView so MainActivity wiring stays put. -->
    <com.bolm.mudif.ui.nav.SidebarView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:elevation="16dp" />
</androidx.drawerlayout.widget.DrawerLayout>
