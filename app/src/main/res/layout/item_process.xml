<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView style="@style/Widget.Mudif.Card.Compact" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/card_press">

    <!-- p56: the process row is a purple gradient card (14dp,
         the Compact radius). Text is white / #E6E6FF; the stop
         button is white text (the old red fails on purple). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_gradient_compact"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/process_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:fontFamily="@font/cairo" />

            <TextView style="@style/TextAppearance.Mudif.Caption"
                android:id="@+id/process_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary"
                android:fontFamily="@font/cairo" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_kill"
            style="@style/Widget.Mudif.Button.TextOnPurple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_stop"
            android:fontFamily="@font/cairo"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
