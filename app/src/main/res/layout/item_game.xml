<?xml version="1.0" encoding="utf-8"?>
<!-- Arcade card: real store icon + name + catalog desc + live
     install state + one working action (install / launch). The
     gamepad glyph is only the fallback when the icon PNG is missing. -->
<com.google.android.material.card.MaterialCardView style="@style/Widget.Mudif.Card" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minHeight="132dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/game_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_gamepad"
                android:contentDescription="@string/tab_games" />

            <TextView
                android:id="@+id/game_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="#E6E6FF"
                android:fontFamily="@font/cairo" />
        </LinearLayout>

        <TextView
            android:id="@+id/game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/game_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#E6E6FF"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_action"
            style="@style/Widget.Mudif.Button.OnPurple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
