<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView style="@style/Widget.Mudif.Card" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/card_press">

    <!-- p56: the system row is a purple gradient card. Text is
         white / #E6E6FF, the install button is the white OnPurple
         pill, the logo sits on a light circle (a purple circle
         would vanish on the gradient). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/home_stat_gradient"
        android:padding="16dp">

        <!-- Phase 1b: the system logo (penguin), not a letter. -->
        <ImageView
            android:id="@+id/distro_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/logo_mudif"
            android:scaleType="fitCenter"
            android:contentDescription="@string/about_system_name"
            android:background="@drawable/circle_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/distro_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:fontFamily="@font/cairo" />

            <TextView style="@style/TextAppearance.Mudif.Caption"
                android:id="@+id/distro_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="@color/card_text_secondary"
                android:fontFamily="@font/cairo" />

            <TextView style="@style/TextAppearance.Mudif.Caption"
                android:id="@+id/distro_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/card_text_secondary"
                android:fontFamily="@font/cairo" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.OnPurple"
            android:id="@+id/btn_install"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/install"
            android:fontFamily="@font/cairo"
            android:textSize="13sp"
            app:cornerRadius="10dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
