<?xml version="1.0" encoding="utf-8"?>
<!-- p52: one bottom-nav tab. The 64x44dp frame holds the active pill
     (visible only when selected) with the Lottie icon centered on it;
     the label sits below. The icon size is set per tab in code
     (BottomNavView), because the five Lottie canvases hold different
     amounts of ink; every icon now renders at 22dp of ink height.
     The label is 13sp, one line, never ellipsized: the agent label
     is the short string (tab_agent_short) so it fits the tab width
     in every language. Padding 12dp top/bottom (was 8dp): the bar
     was too short next to the reference (image-389). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/nav_indicator_width"
        android:layout_height="@dimen/nav_indicator_height">

        <View
            android:id="@+id/nav_item_pill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bottom_nav_active_pill"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/nav_item_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center" />

    </FrameLayout>

    <TextView
        android:id="@+id/nav_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:maxLines="1" />

</LinearLayout>
