<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!-- Status + icon actions (p22: icons, not text buttons, the
         user's order: "ايقونات ماشي كتبة"). Two rows of large circular
         icon buttons; state (record/audio) is shown by the icon/tint,
         never by text. IDs are unchanged so the Kotlin listeners
         attach as before. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_vnc_starting"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_open_viewer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                android:background="@drawable/overlay_icon_bg"
                android:src="@drawable/ic_apps"
                android:padding="14dp"
                android:contentDescription="@string/ui_vnc_diag_open_viewer" />

            <ImageButton
                android:id="@+id/btn_record"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                android:background="@drawable/overlay_icon_bg"
                android:src="@drawable/ic_record"
                android:padding="14dp"
                android:contentDescription="@string/record_start" />

            <ImageButton
                android:id="@+id/btn_tv"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                android:background="@drawable/overlay_icon_bg"
                android:src="@drawable/ic_tv"
                android:padding="14dp"
                android:contentDescription="@string/tv_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_audio"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                android:background="@drawable/overlay_icon_bg"
                android:src="@drawable/ic_audio"
                android:padding="14dp"
                android:contentDescription="@string/audio_off" />

            <ImageButton
                android:id="@+id/btn_show_logs"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                android:background="@drawable/overlay_icon_bg"
                android:src="@drawable/ic_logs"
                android:padding="14dp"
                android:contentDescription="@string/ui_vnc_view_logs" />

            <ImageButton
                android:id="@+id/btn_show_diagnostics"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="8dp"
                android:background="@drawable/overlay_icon_bg"
                android:src="@drawable/ic_info"
                android:padding="14dp"
                android:visibility="gone"
                android:contentDescription="@string/ui_vnc_diagnostics" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
