<?xml version="1.0" encoding="utf-8"?>
<!-- P19 Phase 3: control center + system status (P18.5 #2 + #3).
     Quick controls (Wi-Fi state, volume, brightness) and live status
     (CPU, RAM, storage, battery), all real values, no fake toggles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mudif_purple"
        android:padding="24dp">

        <TextView
            android:id="@+id/control_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/cairo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView style="@style/Widget.Mudif.HeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/control_center"
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/lifta" />

            <TextView style="@style/Widget.Mudif.HeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ui_cc_subtitle"
                android:textSize="14sp"
                android:textColor="#DCD6FF"
                android:fontFamily="@font/cairo" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Mudif.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_cc_quick"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/cairo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView style="@style/TextAppearance.Mudif.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_cc_wifi"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />

                        <TextView
                            android:id="@+id/wifi_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/btn_wifi_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/settings_title"
                            android:textSize="12sp"
                            android:fontFamily="@font/cairo"
                            app:cornerRadius="24dp" />
                    </LinearLayout>

                    <!-- p111: Bluetooth row (state + action button,
                         never a toggle). Mirrors the Wi-Fi row. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView style="@style/TextAppearance.Mudif.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_cc_bluetooth"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />

                        <TextView
                            android:id="@+id/bt_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/btn_bt_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/ui_cc_bt_enable"
                            android:textSize="12sp"
                            android:fontFamily="@font/cairo"
                            app:cornerRadius="24dp" />

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/btn_bt_permission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/ui_cc_bt_perm"
                            android:textSize="12sp"
                            android:fontFamily="@font/cairo"
                            android:visibility="gone"
                            app:cornerRadius="24dp" />
                    </LinearLayout>

                    <TextView style="@style/TextAppearance.Mudif.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/audio_title"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/cairo" />

                    <SeekBar
                        android:progressTint="?attr/mudifAccent"
                        android:thumbTint="?attr/mudifAccent"
                        android:id="@+id/volume_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <TextView style="@style/TextAppearance.Mudif.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ui_cc_brightness"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/cairo" />

                    <SeekBar
                        android:progressTint="?attr/mudifAccent"
                        android:thumbTint="?attr/mudifAccent"
                        android:id="@+id/brightness_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                        android:id="@+id/btn_brightness_permission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ui_cc_brightness_perm"
                        android:textSize="12sp"
                        android:fontFamily="@font/cairo"
                        android:visibility="gone"
                        app:cornerRadius="24dp" />

                    <!-- p111: theme dots row (three dots, current
                         filled with a thicker ring; a tap applies
                         the theme quietly and recreates the panel). -->
                    <TextView style="@style/TextAppearance.Mudif.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ui_cc_theme"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/cairo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/dot_dark"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:padding="0dp"
                            android:text=""
                            android:contentDescription="@string/theme_dark"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/dot_light"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="12dp"
                            android:text=""
                            android:contentDescription="@string/theme_light"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/dot_gradient"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="12dp"
                            android:text=""
                            android:contentDescription="@string/theme_gradient"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <TextView style="@style/TextAppearance.Mudif.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/theme_desktop_note"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:fontFamily="@font/cairo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView style="@style/TextAppearance.Mudif.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_cc_battery"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />

                        <TextView
                            android:id="@+id/battery_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.Mudif.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_cc_status"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />

                        <com.google.android.material.button.MaterialButton style="@style/Widget.Mudif.Button.Primary"
                            android:id="@+id/btn_refresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/task_manager_refresh"
                            android:textSize="12sp"
                            android:fontFamily="@font/cairo"
                            app:cornerRadius="24dp" />
                    </LinearLayout>

                    <TextView style="@style/TextAppearance.Mudif.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ui_cc_cpu"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:fontFamily="@font/cairo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:id="@+id/cpu_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressTint="?attr/mudifAccent" />

                        <TextView
                            android:id="@+id/cpu_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />
                    </LinearLayout>

                    <TextView style="@style/TextAppearance.Mudif.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ui_cc_memory"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:fontFamily="@font/cairo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:id="@+id/ram_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressTint="?attr/mudifAccent" />

                        <TextView
                            android:id="@+id/ram_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />
                    </LinearLayout>

                    <TextView style="@style/TextAppearance.Mudif.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ui_cc_storage"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:fontFamily="@font/cairo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:id="@+id/storage_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressTint="?attr/mudifAccent" />

                        <TextView
                            android:id="@+id/storage_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/cairo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
