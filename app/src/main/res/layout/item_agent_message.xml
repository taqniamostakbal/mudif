<?xml version="1.0" encoding="utf-8"?>
<!-- p30 KissaKoti redesign: the bubble is now a container holding the
     text AND the small grey timestamp inside it (the reference shows
     the time at the bottom inside each bubble). The background and
     padding moved from message_text to message_bubble; the adapter
     sets the background on message_bubble per role. The avatar is
     shown only for agent messages (the adapter hides it for user
     rows); the row gravity is set per role in AgentAdapter.
     p31: maxWidth 272dp -> 240dp (bubbles cap at ~67% of the 360dp
     screen, KissaKoti-like, instead of ~82%). message_time is now
     match_parent + gravity=end instead of layout_gravity="end": a
     gravity child inside a wrap_content bubble is the prime suspect
     for the short-agent-message full-width bubble Anas reported
     ("retry" rendering ~592px wide for one word); match_parent takes
     the bubble's width (driven by the text) and cannot widen it. All
     view IDs preserved. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/message_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/avatar_mudif"
        android:contentDescription="@string/agent_name" />

    <LinearLayout
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/agent_bubble_agent"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/cairo" />

        <TextView
            android:id="@+id/message_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            android:fontFamily="@font/cairo" />
    </LinearLayout>
</LinearLayout>
