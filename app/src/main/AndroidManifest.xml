<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Phase 6: the agent's AccessibilityService (own screens only). -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <!-- Phase 1d: floating icon controls over the viewer. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- p111: Bluetooth state row in the Control Center (state read
         + the system enable dialog only; the app never flips the
         radio itself: enable()/disable() always fail for apps
         targeting API 33+, and Mudif targets 34). BLUETOOTH_CONNECT
         is the runtime permission on API 31+; BLUETOOTH +
         BLUETOOTH_ADMIN are install-time on API 30 and below. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".MudifApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mudif">
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Consolidated fix item 5: rotation must not recreate
             this activity mid-turn. Without configChanges, a
             rotation destroyed AgentFragment, onDestroyView
             cancelled the turn and aborted the live server session,
             and the next turns on that session finished instantly
             with no text until a model switch made a new session. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|density|fontScale"
            android:windowSoftInputMode="adjustResize" />
        <!-- p31: provider-selection screen (free AI platforms). -->
        <activity
            android:name=".ui.agent.BrainProvidersActivity"
            android:exported="false"
            android:label="@string/brain_providers_title" />
        <activity
            android:name=".ui.terminal.TerminalActivity"
            android:exported="false"
            android:label="@string/tab_terminal"
            android:windowSoftInputMode="adjustPan" />
        <!-- p75: rotation must not recreate this activity on entry.
             Without configChanges, entering from portrait destroyed
             and recreated it (landscape lock): the new instance's
             startDesktop() returned at once on the startInProgress
             flag while the first instance's thread finished the
             work against a destroyed activity, so startlxqt was
             never sent and the status screen stalled. With the
             rotation handled here, the same instance that started
             the run finishes it and opens the viewer. -->
        <activity
            android:name=".ui.vnc.VncActivity"
            android:exported="false"
            android:label="@string/ui_vnc_activity_label"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/viewer_settings_title" />
        <activity
            android:name=".ui.logs.LogViewerActivity"
            android:exported="false"
            android:label="@string/log_title" />
        <activity
            android:name=".ui.control.ControlCenterActivity"
            android:exported="false"
            android:label="@string/control_center" />
        <activity
            android:name=".ui.control.TaskManagerActivity"
            android:exported="false"
            android:label="@string/task_manager_title" />
        <!-- Take 4: FileProvider for the in-app updater. The APK in
             the app cache is shared with the system installer only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/updater_file_paths" />
        </provider>
        <receiver
            android:name=".ui.control.ScreenRecordReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bolm.mudif.STOP_SCREEN_RECORDING" />
            </intent-filter>
        </receiver>
        <service
            android:name=".engine.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Phase 6: supervisor for the whole-app agent (bridge + brain server). -->
        <service
            android:name=".engine.AgentSupervisorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Phase 6: the agent's hands/eyes on the Android layer.
             Enabled by the user in Settings > Accessibility; the app
             cannot enable it itself. -->
        <service
            android:name=".ui.agent.MudifAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mudif_accessibility_service_config" />
        </service>
        <!-- p118: the Mudif keyboard (system input method). The
             user enables it once in Settings; inside the viewer it
             then appears instead of Gboard. Exported because the
             system (a different process) binds to it; the
             BIND_INPUT_METHOD permission is what restricts that
             binding to the system alone. Android never lets an app
             force an IME silently. -->
        <service
            android:name=".ui.keyboard.MudifKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/mudif_keyboard_method" />
        </service>
        <!-- Phase 2, Google Cast sender: the framework reads the
             OptionsProvider (Default Media Receiver, no custom app ID)
             from this meta-data. No Remote Display API is used. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.bolm.mudif.engine.CastOptionsProvider" />
    </application>
</manifest>
