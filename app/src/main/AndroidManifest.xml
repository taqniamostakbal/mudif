<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Phase 6: the agent's AccessibilityService (own screens only). -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <!-- Phase 1d: floating icon controls over the viewer. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mudif">
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- p31: provider-selection screen (free AI platforms). -->
        <activity
            android:name=".ui.agent.BrainProvidersActivity"
            android:exported="false"
            android:label="@string/brain_providers_title" />
        <activity
            android:name=".ui.terminal.TerminalActivity"
            android:exported="false"
            android:label="@string/tab_terminal"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.vnc.VncActivity"
            android:exported="false"
            android:label="@string/ui_vnc_activity_label"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/viewer_settings_title" />
        <activity
            android:name=".ui.logs.LogViewerActivity"
            android:exported="false"
            android:label="@string/log_title" />
        <activity
            android:name=".ui.control.ControlCenterActivity"
            android:exported="false"
            android:label="@string/control_center" />
        <activity
            android:name=".ui.control.TaskManagerActivity"
            android:exported="false"
            android:label="@string/task_manager_title" />
        <receiver
            android:name=".ui.control.ScreenRecordReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bolm.mudif.STOP_SCREEN_RECORDING" />
            </intent-filter>
        </receiver>
        <service
            android:name=".engine.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Phase 6: supervisor for the whole-app agent (bridge + brain server). -->
        <service
            android:name=".engine.AgentSupervisorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Phase 6: the agent's hands/eyes on the Android layer.
             Enabled by the user in Settings > Accessibility; the app
             cannot enable it itself. -->
        <service
            android:name=".ui.agent.MudifAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mudif_accessibility_service_config" />
        </service>
        <!-- Phase 2 — Google Cast sender: the framework reads the
             OptionsProvider (Default Media Receiver, no custom app ID)
             from this meta-data. No Remote Display API is used. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.bolm.mudif.engine.CastOptionsProvider" />
    </application>
</manifest>
