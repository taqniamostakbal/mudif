[Icon Theme]
Name=mudif
Comment=Mudif icon theme (purple harmony, inherits bloom-dark)
Inherits=bloom-dark
Directories=apps/scalable,places/scalable,apps/64x64,apps/80x80

[apps/scalable]
Size=48
Context=Applications
Type=Scalable
MinSize=16
MaxSize=512

[places/scalable]
Size=48
Context=Places
Type=Scalable
MinSize=16
MaxSize=512

[apps/64x64]
Size=64
Context=Applications
Type=Fixed

[apps/80x80]
Size=80
Context=Applications
Type=Fixed
