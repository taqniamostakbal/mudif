/*
 * p98: Dark variant of lxqt-panel.qss, generated by
 * p98-build/qss_build.py from the p97 base
 * (app/src/main/assets/mudif-theme/lxqt-panel.qss). The base
 * file stays the working copy; ensureLxqtLook copies the active
 * variant over the live path. Values are the theme-system
 * DESIGN.md section 2a values; derived values are noted in the
 * generator. The inline p87/p95 comments below describe the base
 * file's history and stay untouched.
 */
/*
 * General panel settings
 */

LXQtPanel #BackgroundWidget {
    background: #141021;
}

QToolTip {
    border: 1px solid hsv(0, 0, 41);
    background: hsv(0, 0, 20);
    padding: 2px;
    margin: 0px;
    color: #DEDEDE
}

/*
 * General plugins settings
 */

Plugin,
LXQtPanelPlugin {
    padding: 0;
    spacing: 20px;
    qproperty-moveMarkerColor: #8B7CF5;
}

Plugin > QWidget,
Plugin > QWidget > QWidget {
    color: #DEDEDE;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    margin: 0;
    border: 1px solid transparent;
    qproperty-iconSize: 24px;
    color: #DEDEDE;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    padding: 4px;
}

/*
 * Volume plugin
 */
VolumePopup {
    background: hsv(0, 0, 41);
    margin: 2px;
}

VolumePopup > QPushButton {
    border: 1px solid rgba(255, 255, 255, 5%);
    border-radius: 2px;
    color: #DEDEDE;
    background: rgba(255, 255, 255, 10%);
    padding: 2px 10px;
    margin: 3px;
    qproperty-iconSize: 24px;
}

VolumePopup > QPushButton:hover {
    border: 1px solid rgba(255, 255, 255, 10%);
    border-radius: 2px;
    background: rgba(255, 255, 255, 20%);
}

VolumePopup > QSlider::groove:vertical {
    background: hsv(0, 0, 41);
    width: 8px;
    border-radius: 3px;
}

VolumePopup > QSlider::handle:vertical {
    height: 10px;
    background: #DEDEDE;
    border-radius: 5px;
    margin: 0 -4px; /* expand outside the groove */
}

VolumePopup > QSlider::add-page:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
            stop: 0 #787676, stop: 1 #ABABAB);
    border: 1px solid rgba(0, 0, 0, 80%);
    border-radius: 3px;

}

VolumePopup > QSlider::sub-page:vertical {
    background: rgba(0, 0, 0, 80%);
    border-radius: 3px;
}

/*
 *Backlight Plugin
 */
#Backlight QToolButton {
    color: #f2f1f0;
    background: #363532;
    padding: 2px;
    margin: 1px;
    qproperty-iconSize: 24px;
}

#Backlight QToolButton:pressed {
    padding: 4px;
}

#Backlight QToolButton:hover {
    border: 1px solid rgba(255, 255, 255, 10%);
    border-radius: 2px;
    background: rgba(255, 255, 255, 20%);
}

#Backlight > SliderDialog {
    background: hsv(0, 0, 41);
}

#Backlight > SliderDialog > QSlider::groove:vertical {
    background: hsv(0, 0, 41);
    width: 5px;
    border-radius: 3px;
}

#Backlight > SliderDialog > QSlider::handle:vertical {
    height: 10px;
    background: #DEDEDE;
    border-radius: 4px;
    margin: 0 -4px; /* expand outside the groove */
}

#Backlight > SliderDialog > QSlider::add-page:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
            stop: 0 #787676, stop: 1 #ABABAB);
    border: 1px solid rgba(0, 0, 0, 80%);
}

#Backlight > SliderDialog > QSlider::sub-page:vertical {
    background: rgba(0, 0, 0, 80%);
}

/*
 * Desktopswitch
 */
#DesktopSwitch QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

#DesktopSwitch QToolButton:on {
    background: #593BFE;
    border: 1px solid #593BFE;
    font: bold;
}

#DesktopSwitch QToolButton:hover:on {
    background: #8B7CF5;
    border: 1px solid #8B7CF5;
}

#DesktopSwitch QToolButton:pressed {
    background: #3D2C9E;
    padding: 4px;
}

#DesktopSwitch QToolButton[urgent="true"] {
    color: white;
    background: #593BFE;
    border: 1px solid #8B7CF5;
}

/*
 * QuickLaunch
 */
#QuickLaunchPlaceHolder {
    color: #AAAAAA;
    padding: 0 5px;
}

#QuickLaunch QToolButton {
    border: 0px;
    margin: 1px;
    padding: 2px;
}

#QuickLaunch QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

#QuickLaunch QToolButton:pressed {
    padding: 4px;
}

/*
 * TaskBar
 */
#TaskBar QToolButton {
    margin: 2px;
    padding: 2px;
    background: #2C1F6E;
    border-radius: 11px;
    color: #FEFCFF;
}

#TaskBar QToolButton:on {
    border: none;
    background: #2C1F6E;
}

#TaskBar QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

#TaskBar QToolButton:pressed {
    padding: 4px;
}

#TaskBar QToolButton[urgent="true"] {
    color: palette(highlighted-text);
    background: palette(highlight);
}

#TaskBar LXQtGroupPopup {
    background: rgba(61, 44, 158, 100%);
    border: 1px solid rgba(0, 0, 0, 40%);
    ;
}

/*
 * Calendar Widget
 */
QCalendarWidget QAbstractItemView:enabled {
    color: white;
    background: black;
    selection-background-color: #593BFE;
    selection-color: white;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #969696;
}

QCalendarWidget QWidget {
    alternate-background-color: #3c3c3c;
}

QCalendarWidget #qt_calendar_navigationbar,
QCalendarWidget #qt_calendar_navigationbar * {
    background-color: hsv(0, 0, 41);
    color: #DEDEDE;
}

QCalendarWidget #qt_calendar_monthbutton {
    padding: 2px;
    margin: 2px;
}

QCalendarWidget #qt_calendar_monthbutton:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

QCalendarWidget #qt_calendar_monthbutton::menu-indicator {
    image: none;
}

QCalendarWidget QTableView {
    selection-background-color: hsv(0, 0, 41);
}

QCalendarWidget #qt_calendar_nextmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/right-arrow.svg);
}

QCalendarWidget #qt_calendar_prevmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/left-arrow.svg);
}

/*
 * Clock
 */
#Clock:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

#Clock > QWidget {
    margin: 2px;
}

#Clock #TimeLabel {
    color: #FDFBFF;
    font-family: "DejaVu Sans";
    font-size: 20px;
    margin-right: 2px;
    margin-left: 2px;
}

#Clock #DateLabel {
    color: #EEEDF3;
    font-family: "Cairo";
    font-size: 13px;
    margin-right: 2px;
    margin-left: 2px;
}

/*
 * Tray
 */
#Tray {
    min-width: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

TrayIcon {
    margin: 2px;
}

/*
 * All menus
 *
 * p87 (desktop polish step 3, spec section 2 + section 9 right-click
 * menus in the same language): the menus are the frosted LIGHT panel,
 * not the dark purple. Solid near-white lavender #F7F5FF (NOT a
 * translucent rgba): true frosted translucency is impossible in this
 * guest - no compositor runs in the session and the FancyMenu window
 * sets no WA_TranslucentBackground (lxqt-panel 2.1.4 source,
 * plugin-fancymenu/lxqtfancymenuwindow.cpp; THEME-READINESS.md:93
 * already proved menus are effectively opaque here). A translucent
 * white would blend against the dark palette window color and render
 * gray, not frosted white. The p85 dark-menu colors are superseded
 * here on purpose: enabled text #333333 (spec section 7 body text),
 * disabled #888888 (section 7 secondary text), selected stays
 * #593BFE + white (the p85 active-row rule, unchanged).
 */

QMenu {
    margin: 0px;
    padding: 2px;
    border: 1px solid rgba(242, 239, 255, 20%);
    background: #1E1830;
    color: #F2EFFF;
}

QMenu::icon {
    background-color: transparent;
    border: 20px;
}

QMenu QToolButton {
    background-color: transparent;
    padding: 5px;
    border: none;
    color: #F2EFFF;
    font: bold italic;
}

QMenu::separator {
    background-color: #353047;
    height: 1px;
}

QMenu::item {
    border: 10px solid transparent;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    padding: 6px 40px 6px 24px;
    background: transparent;
    color: #F2EFFF;
}

QMenu::item:selected {
    border: 10px solid #593BFE;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    background: #593BFE;
    color: white;
}

QMenu::item:selected:disabled {
    /* p88: explicit #D9D5E8, NOT palette(text). The light palette
       (spec section 3) makes palette(text) #333333, which would
       paint a dark background behind disabled text here. */
    background-color: #353047;
}

QMenu::item:disabled {
    color: #9A9A9A;
    background-color: transparent;
}

QMenu::right-arrow {
    image: url(arrow-right.svg);
}

QMenu::left-arrow {
    image: url(arrow-left.svg);
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
    image: url(checked.svg);
}

/*
 * Main menu
 * p87: same frosted light language as #FancyMenu (spec section 2).
 * This is the classic menu surface, not the active launcher (the panel
 * uses type=fancymenu), but it gets the same treatment so the desktop
 * does not carry two menu languages.
 */

#MainMenu {
    margin: 2px;
    padding: 2px;
    border: none;
    background: #1E1830;
    qproperty-icon: url(mainmenu.png);
    color: #F2EFFF;
}

#MainMenu QLineEdit {
    background: #241D3D;
    border: 1px solid rgba(242, 239, 255, 25%);
    border-radius: 12px;
    padding: 6px 10px;
    margin-bottom: 4px;
    color: #F2EFFF;
    selection-background-color: #593BFE;
    selection-color: white;
}

#MainMenu ActionView {
    border: none;
    background: transparent;
    color: #F2EFFF;
}

#MainMenu ActionView::item {
    background: transparent;
    color: #F2EFFF;
    border: none;
    padding: 4px 3px 4px 10px;
}

#MainMenu ActionView::item:hover {
    background: rgba(255, 255, 255, 20%);
    border-radius: 6px;
    color: #F2EFFF;
}

#MainMenu ActionView::item:selected {
    background: #593BFE;
    border-radius: 6px;
    color: white;
}

/*
/*
 * Fancy menu
 * p87: the launcher restyle (desktop polish spec section 2). Solid
 * frosted-light panel #F7F5FF, dark text #333333, accent #593BFE only.
 * Solid, NOT translucent: no compositor runs in this guest and the
 * window sets no WA_TranslucentBackground (lxqt-panel 2.1.4 source),
 * so an rgba white would blend against the dark palette window color
 * and render gray. The rail (#CategoryView) is a subtle lavender
 * strip over the same solid panel color. The rail sits on the RIGHT
 * in RTL: that is a CONFIG change, not QSS - categoriesAtRight=false
 * in the panel mainmenu keys (LxqtLook.kt mergePanelConf, p87) - the
 * code default is true and QHBoxLayout mirrors it to the visual left.
 */

/*
 * p95: the panel BUTTON (not the popup window below, which stays
 * #F7F5FF). The #F7F5FF background here painted the white sliver
 * the p93 round measured at the right edge, so the button is
 * transparent now and the penguin sits on the dark panel. The
 * button is ~67px wide (48px icon + 16px side padding + ~3px
 * frame; measured 29 = 22 + 4 + 3 before). The 48px icon comes
 * from panel.conf [General] iconSize, NOT from here: the panel's
 * own stylesheet sets qproperty-iconSize on every plugin button
 * and an ancestor stylesheet beats this theme QSS, so a
 * qproperty-iconSize rule here would be silently dead. The
 * LXQtFancyMenuWindow rule below is untouched (the popup stays
 * light by design).
 */
#FancyMenu {
    margin: 2px;
    padding: 2px 8px;
    border: none;
    background: transparent;
    qproperty-icon: url(mainmenu.png);
    color: #F2EFFF;
}

#FancyMenu:hover {
    background: rgba(255, 255, 255, 20%);
}

LXQtFancyMenuWindow {
    background: #1E1830;
    border-radius: 16px;
}

#FancyMenu QLineEdit {
    background: #241D3D;
    border: 1px solid rgba(242, 239, 255, 25%);
    border-radius: 12px;
    padding: 6px 10px;
    margin-bottom: 4px;
    color: #F2EFFF;
    selection-background-color: #593BFE;
    selection-color: white;
}

#FancyMenu #AppView {
    border: none;
    background: transparent;
    color: #F2EFFF;
}

#FancyMenu #CategoryView {
    border: none;
    background: rgba(89, 59, 254, 64);
    color: #F2EFFF;
}

#FancyMenu QListView::item {
    color: #F2EFFF;
    border: none;
    padding: 4px 3px 4px 10px;
}

#FancyMenu QListView::item:hover {
    background: rgba(255, 255, 255, 20%);
    border-radius: 6px;
    color: #F2EFFF;
}

#FancyMenu QListView::item:selected {
    background: #593BFE;
    border-radius: 6px;
    color: white;
}

#FancyMenu QListView::focus {
    outline:transparent;
    padding: 0px;
}

#FancyMenu QLabel {
    color: #A99FD0;
}

#FancyMenu QToolButton {
    margin: 3px;
    border-radius: 4px;
    border: 1px solid transparent;
    padding: 4px;
    background: transparent;
    color: #F2EFFF;
}

#FancyMenu QToolButton:hover,
#FancyMenu QToolButton:focus {
    background: rgba(255, 255, 255, 20%);
    border: 1px solid rgba(242, 239, 255, 25%);
}

#FancyMenu QToolButton:pressed {
    background: #593BFE;
    color: white;
}

#FancyMenu QScrollBar:vertical {
    background-color: transparent;
    width: 15px;
    margin: 2px 2px 2px 2px;
    border: 1px solid transparent;
}

#FancyMenu QScrollBar:horizontal {
    background-color: transparent;
    height: 15px;
    margin: 2px 2px 2px 2px;
    border: 1px solid transparent;
}

#FancyMenu QScrollBar::handle:vertical {
    background-color: #593BFE;
    border: 0px solid #593BFE;
    min-height: 40px;
    border-radius: 3px;
    margin: 1px;
}

#FancyMenu QScrollBar::handle:horizontal {
    background-color: #593BFE;
    border: 0px solid #593BFE;
    min-width: 40px;
    border-radius: 3px;
    margin: 1px;
}

#FancyMenu QScrollBar::handle:hover{
    background-color: #8B7CF5;
    border: 1px solid #8B7CF5;
    margin: 0px;
}

#FancyMenu QScrollBar::add-line:vertical,
#FancyMenu QScrollBar::sub-line:vertical {
    border: 0px solid transparent;
    background: transparent;
    width: 0px;
}

#FancyMenu QScrollBar::add-line:horizontal,
#FancyMenu QScrollBar::sub-line:horizontal {
    border: 0px solid transparent;
    background: transparent;
    width: 0px;
}

#FancyMenu QAbstractScrollArea::corner {
    background: transparent;
}

/*
 * Mount plugin
 */
#LXQtMountPlugin {
    margin: 2px;
}

#LXQtMountPopup {
    background-color: hsv(0, 0, 41);
    padding: 4px;
}

#LXQtMountPopup > MenuDiskItem {
    border-radius: 4px;
}

#LXQtMountPopup > MenuDiskItem:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

#LXQtMountPopup #EjectButton,
#LXQtMountPopup #DiskButton {
    qproperty-iconSize: 22px;
    background-color: transparent;
    border: none;
    color: #EEEEEE;
    padding: 4px;
}

#LXQtMountPopup #NoDiskLabel {
    margin: 6px;
    color: #CCCCCC;
}


/*
 * ShowDesktop
 */
#ShowDesktop > QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

/*
 * KbIndicator
 */
#KbIndicator > QLabel {
    padding: 3px;
    border: 0px;
    font: bold;
}

#KbIndicator > QLabel:disabled {
    color: #b4b4b4;
}

#KbIndicator > QLabel:enabled {
    color: white;
    background: #593BFE;
}

/*
 * SysStat
 */
#SysStat {
    padding: 2px 2px 2px 2px;
    margin: 2px;
}

#SysStat > QLabel {
    font-size: 6pt;
}

#SysStat_Graph {
    qproperty-gridColor: rgba(255, 255, 255, 25%);
    qproperty-titleColor: rgba(255, 255, 255, 75%);
    qproperty-cpuSystemColor: rgb(128, 0, 0);
    qproperty-cpuUserColor: rgb(0, 0, 128);
    qproperty-cpuNiceColor: rgb(0, 128, 0);
    qproperty-cpuOtherColor: rgb(128, 128, 0);
    qproperty-frequencyColor: rgb(96, 96, 96);
    qproperty-memAppsColor: rgb(0, 0, 128);
    qproperty-memBuffersColor: rgb(0, 128, 0);
    qproperty-memCachedColor: rgb(128, 128, 0);
    qproperty-swapUsedColor: rgb(128, 0, 0);
    qproperty-netReceivedColor: rgb(0, 0, 128);
    qproperty-netTransmittedColor: rgb(128, 128, 0);
}

/*
 * WorldClock
 */
#WorldClock:hover {
    border: 1px solid rgba(0, 0, 0, 50%);
    background: rgba(255, 255, 255, 20%);
}

#WorldClockContent {
    margin-right: 2px;
    margin-left: 2px;
    padding: 2px;
    color: #DEDEDE;
    background: transparent;
}

/*
 * CPU monitor
 */
#LXQtCpuLoad {
    qproperty-fontColor: #DEDEDE;
}

/*
 * Spacer
 *
 * P9FIX5: EVERYTHING the spacer needs is on the base #Spacer rule
 * with NO [type="..."] and NO [orientation="..."] condition. The
 * P9FIX4 re-test proved property-conditioned rules never match at
 * runtime: lxqt-panel applies the theme stylesheet BEFORE it sets
 * the spacer's type AND orientation (setType/setOrientation do not
 * trigger a stylesheet re-polish, and the type Q_PROPERTY is
 * read-only with no NOTIFY), so #Spacer[type="lined"] and
 * #Spacer[orientation="horizontal"] never match. A rule with no
 * property condition matches at any time. The spacer is always
 * "lined" and always horizontal in our panel.conf (bottom panel),
 * so the base rule carries the line image + repeat-y + margins.
 * The [type="dotted"] override is unused and would still suffer
 * the timing issue; it is kept only as documentation.
 * (First attempt put only the image on the base rule and left
 * repeat-y in the orientation rule; a probe then rendered
 * 12800/12800 non-bg px: the image tiled in both directions
 * because the repeat rule never matched. The repeat must be
 * on the base rule too.)
 */
#Spacer {
    background-position: center center;
    background-image: url(/spacer-plugin/spacer-line.png);
    background-repeat: repeat-y;
    margin-top: 2px;
    margin-bottom: 2px;
}

#Spacer[type="dotted"] {
    background-image: url(/spacer-plugin/spacer-dots.png);
}

/*
 * CustomCommand Plugin
 */

#Custom::hover {
    background: black;
    color: #f9f9f9;
}
