!! Onyx by Dana Jansens
!! inspired by "Carbon" by p0ng, and the ever so popular Vista glass look
!! p98 Glass Dark variant (DESIGN.md section 2a): menus are the
!! current dark themerc, kept; titlebars are dark (#241D3D active,
!! #1E1830 inactive), text #F2EFFF / #A99FD0, glyphs #F2EFFF /
!! #A99FD0, borders and client #353047 / #1E1830. Hover/pressed
!! purples, OSD, fonts and padding are the current file, kept.

!! Menu background
menu.items.bg: flat gradient vertical
menu.items.bg.color: #2A1F6E
menu.items.bg.colorTo: #1A1038

!! Menu text
menu.items.text.color: #ffffff
menu.items.justify: left
menu.items.disabled.text.color: #9a9a9a

!! Menu headers
menu.title.bg: raised splitvertical gradient
menu.title.bg.color: #3D2C9E
menu.title.bg.colorTo: #2A1F6E
menu.title.text.color: white
menu.title.text.justify: center

!! Selected menu item
menu.items.active.bg: raised splitvertical gradient
menu.items.active.bg.color: #593BFE
menu.items.active.bg.colorTo: #3D2C9E
menu.items.active.text.color: #f8f8f8

!! Titlebar
!! p88 (desktop polish spec section 3, Zorin white windows):
!! flat white title bars (active #FFFFFF, inactive #F5F5F5),
!! dark title text #333333, dark button glyphs #555555, light
!! borders. Openbox draws square frames: true rounded corners
!! ~16px and the drop shadow need a compositor (picom, ideas
!! item 3, NOT built) - this build styles what openbox can draw.
!! The menu colours above are the p85 fix, untouched.
window.active.title.bg: flat solid
window.active.title.bg.color: #241D3D
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1E1830

!! Titlebar text
window.label.text.justify: center
window.active.label.bg: parentrelative
window.active.label.text.color: #F6F3FE
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #A99FD0

!! Window buttons
window.*.button.*.bg: parentrelative
window.active.button.*.hover.bg: flat splitvertical gradient border
window.inactive.button.*.hover.bg: parentrelative
window.*.button.*.pressed.bg: flat splitvertical gradient border

window.active.button.*.hover.bg.color: #8B7CF5
window.active.button.*.hover.bg.colorTo: #593BFE
window.active.button.*.hover.bg.border.color: #593BFE

window.active.button.*.pressed.bg.color: #3D2C9E
window.active.button.*.pressed.bg.colorTo: #2A1F6E
window.active.button.*.pressed.image.color: #898989
window.active.button.*.pressed.bg.border.color: #2A1F6E
window.inactive.button.*.pressed.bg.color: #8B7CF5
window.inactive.button.*.pressed.bg.colorTo: #6A5AE0
window.inactive.button.*.pressed.image.color: #b7fdef
window.inactive.button.*.pressed.bg.border.color: #6A5AE0

window.active.button.*.image.color: #F2EFFF
window.active.button.disabled.image.color: #6B6486
window.inactive.button.*.image.color: #A99FD0
window.inactive.button.disabled.image.color: #6B6486

!! Borders
window.active.border.color: #353047
window.inactive.border.color: #353047
window.inactive.title.separator.color: #353047
border.width: 1
padding.width: 4
window.handle.width: 0
window.active.client.color:  #1E1830
window.inactive.client.color:  #1E1830
window.client.padding.width: 1
window.client.padding.height: 1
menu.overlap: 0

!! Font shadows
menu.items.font:shadow=n

!! On-screen displays
osd.bg: gradient vertical flat
osd.bg.color: #303030
osd.bg.colorTo: #080808

!! p100: traffic-light dots (SAMPLE-SPEC.md section 3). The three
!! titlebar buttons are solid 14 px discs (close.xbm, iconify.xbm,
!! max.xbm in this theme dir) tinted per button. Specific per-button
!! keys override the generic window.*.button.*.image.color above.
!! Active and inactive use the same colors (the sample measures one
!! active window only); pressed/hover/disabled/toggled match so the
!! dots never revert to white glyphs.
window.active.button.close.unpressed.image.color: #FF5F56
window.active.button.close.pressed.image.color: #FF5F56
window.active.button.close.hover.image.color: #FF5F56
window.active.button.close.disabled.image.color: #FF5F56
window.inactive.button.close.unpressed.image.color: #FF5F56
window.inactive.button.close.pressed.image.color: #FF5F56
window.inactive.button.close.hover.image.color: #FF5F56
window.inactive.button.close.disabled.image.color: #FF5F56
window.active.button.iconify.unpressed.image.color: #FFBD2E
window.active.button.iconify.pressed.image.color: #FFBD2E
window.active.button.iconify.hover.image.color: #FFBD2E
window.active.button.iconify.disabled.image.color: #FFBD2E
window.inactive.button.iconify.unpressed.image.color: #FFBD2E
window.inactive.button.iconify.pressed.image.color: #FFBD2E
window.inactive.button.iconify.hover.image.color: #FFBD2E
window.inactive.button.iconify.disabled.image.color: #FFBD2E
window.active.button.max.unpressed.image.color: #27C93F
window.active.button.max.pressed.image.color: #27C93F
window.active.button.max.hover.image.color: #27C93F
window.active.button.max.disabled.image.color: #27C93F
window.active.button.max.unpressed.toggled.image.color: #27C93F
window.active.button.max.pressed.toggled.image.color: #27C93F
window.active.button.max.hover.toggled.image.color: #27C93F
window.inactive.button.max.unpressed.image.color: #27C93F
window.inactive.button.max.pressed.image.color: #27C93F
window.inactive.button.max.hover.image.color: #27C93F
window.inactive.button.max.disabled.image.color: #27C93F
window.inactive.button.max.unpressed.toggled.image.color: #27C93F
window.inactive.button.max.pressed.toggled.image.color: #27C93F
window.inactive.button.max.hover.toggled.image.color: #27C93F
